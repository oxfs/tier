[global]
    server role = standalone server

[tier]
    path = /srv/tier/primary
    vfs objects = tier_v2
    tier_v2:config = /etc/tier-v2/config.toml
    read only = no
    force user = tier-v2
    force group = tier-v2
    valid users = USERNAME
    kernel share modes = no
    posix locking = no
    store dos attributes = no
    ea support = no
    map archive = no
