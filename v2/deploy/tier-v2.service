[Unit]
Description=Tier directory replication and archive maintenance
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tier-v2
Group=tier-v2
ExecStart=/usr/local/bin/tier-v2 /etc/tier-v2/config.toml run
EnvironmentFile=-/etc/tier-v2/secrets
Restart=on-failure
RestartSec=5
Nice=10
IOSchedulingClass=idle
UMask=0007

[Install]
WantedBy=multi-user.target
