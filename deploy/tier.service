[Unit]
Description=Tier directory replication and archive maintenance
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tier
Group=tier
ExecStart=/usr/local/bin/tier /etc/tier/config.toml
EnvironmentFile=-/etc/tier/secrets
Environment=TIER_WEB_LISTEN=0.0.0.0:9999
Restart=on-failure
RestartSec=5
Nice=10
IOSchedulingClass=idle
UMask=0007

[Install]
WantedBy=multi-user.target
