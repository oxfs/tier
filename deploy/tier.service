[Unit]
Description=Tier NAS
After=local-fs.target network-online.target
Wants=network-online.target
Before=smbd.service

[Service]
Environment=LD_PRELOAD=libjemalloc.so.2
Environment=MALLOC_CONF=narenas:4
ExecStart=/usr/local/bin/tier --config /etc/tier/tier.toml serve
Group=tier
StateDirectory=tier
StateDirectoryMode=0700
RuntimeDirectory=tier
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
